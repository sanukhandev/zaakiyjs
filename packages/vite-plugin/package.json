{
  "name": "@zaakiyjs/vite-plugin",
  "version": "0.1.0-beta.0",
  "license": "MIT",
  "author": {
    "name": "Sanu Khan",
    "url": "https://sanukhan.dev"
  },
  "description": "First-party Vite compiler and styles integration for ZaakiyJS (draft pending upstream runtime)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zaakiyjs/compat": "workspace:^",
    "@zaakiyjs/compiler": "workspace:^",
    "@zaakiyjs/styles": "workspace:^",
    "postcss": "8.5.32"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanukhandev/zaakiyjs.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/sanukhandev/zaakiyjs",
  "bugs": {
    "url": "https://github.com/sanukhandev/zaakiyjs/issues"
  }
}
