{
  "name": "@zaakiyjs/vite-plugin",
  "version": "0.0.0",
  "description": "First-party Vite compiler and styles integration for ZaakiyJS (draft pending upstream runtime)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test tests vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zaakiyjs/compiler": "workspace:^",
    "@zaakiyjs/styles": "workspace:^"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  }
}
