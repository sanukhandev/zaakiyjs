{
  "name": "@zaakiyjs/compiler",
  "version": "0.0.0",
  "description": "Node-only TypeScript/TSX to versioned IR and native ZaakiyJS DOM compiler (safe v1 subset)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
