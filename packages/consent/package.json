{
  "name": "@zaakiyjs/consent",
  "version": "0.1.0-beta.0",
  "license": "MIT",
  "author": {
    "name": "Sanu Khan",
    "url": "https://sanukhan.dev"
  },
  "description": "Fail-closed, signal-driven consent policy and optional vendor authorization",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.types.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zaakiyjs/signals": "workspace:^",
    "@zaakiyjs/core": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanukhandev/zaakiyjs.git",
    "directory": "packages/consent"
  },
  "homepage": "https://github.com/sanukhandev/zaakiyjs",
  "bugs": {
    "url": "https://github.com/sanukhandev/zaakiyjs/issues"
  }
}
