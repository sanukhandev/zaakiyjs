{
  "name": "@zaakiyjs/async",
  "version": "0.0.0",
  "description": "Scoped cancellable reactive resources and tasks for ZaakiyJS",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.types.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@zaakiyjs/core": "workspace:^",
    "@zaakiyjs/signals": "workspace:^"
  }
}
