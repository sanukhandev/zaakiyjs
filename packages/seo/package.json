{
  "name": "@zaakiyjs/seo",
  "version": "0.0.0",
  "description": "Pure SEO metadata, structured data and sitemap engine",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --root ../.. packages/seo/test",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
