{
  "name": "@zaakiyjs/analytics",
  "version": "0.0.0",
  "description": "Opt-in privacy-aware analytics for ZaakiyJS (draft P3 contract integration)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./vitals": {
      "types": "./dist/vitals.d.ts",
      "import": "./dist/vitals.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.types.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
