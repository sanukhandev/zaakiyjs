{
  "name": "@zaakiyjs/analytics",
  "version": "0.1.0-beta.0",
  "license": "MIT",
  "author": {
    "name": "Sanu Khan",
    "url": "https://sanukhan.dev"
  },
  "description": "Opt-in privacy-aware analytics for ZaakiyJS (draft P3 contract integration)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./vitals": {
      "types": "./dist/vitals.d.ts",
      "import": "./dist/vitals.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.types.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test",
    "pack:check": "npm pack --dry-run --json",
    "test:browser": "python3 test/browser/acceptance.py"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanukhandev/zaakiyjs.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://github.com/sanukhandev/zaakiyjs",
  "bugs": {
    "url": "https://github.com/sanukhandev/zaakiyjs/issues"
  }
}
