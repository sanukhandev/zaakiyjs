{
  "name": "@zaakiyjs/motion",
  "version": "0.0.0",
  "description": "Optional owner-scoped native motion controllers for ZaakiyJS",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./route": { "types": "./dist/route.d.ts", "import": "./dist/route.js" }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run --root ../.. packages/motion/test",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": { "access": "public" },
  "dependencies": { "@zaakiyjs/core": "workspace:^" },
  "devDependencies": { "jsdom": "^26.1.0" }
}
