{
  "name": "@zaakiyjs/dom",
  "version": "0.0.0",
  "description": "Owner-scoped targeted native DOM runtime for compiled ZaakiyJS views",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zaakiyjs/core": "workspace:^",
    "@zaakiyjs/signals": "workspace:^"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
