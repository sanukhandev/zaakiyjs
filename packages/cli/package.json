{
  "name": "@zaakiyjs/cli",
  "version": "0.0.0",
  "description": "First-party ZaakiyJS application scaffolding, generators and toolchain commands",
  "type": "module",
  "sideEffects": false,
  "engines": {"node": ">=20.19.0"},
  "bin": {"zaakiy": "./dist/bin.js"},
  "files": ["dist", "templates", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src tests test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run tests test",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {"access": "public"},
  "dependencies": {
    "@zaakiyjs/core": "workspace:^",
    "@zaakiyjs/dom": "workspace:^",
    "@zaakiyjs/signals": "workspace:^",
    "@zaakiyjs/styles": "workspace:^",
    "@zaakiyjs/vite-plugin": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.15.30"
  }
}
