{
  "name": "@zaakiyjs/ui",
  "version": "0.0.0",
  "description": "ZaakiyJS brand-aware native DOM UI foundation (draft P2 slice)",
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "CHANGELOG.md",
    "src/styles.css.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./src/styles.css.d.ts",
      "import": "./src/styles.css"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test",
    "test:browser": "python3 test/browser/acceptance.py",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@zaakiyjs/core": "workspace:^",
    "@zaakiyjs/dom": "workspace:^",
    "@zaakiyjs/signals": "workspace:^",
    "@zaakiyjs/ui-primitives": "workspace:^"
  },
  "devDependencies": {
    "@zaakiyjs/compiler": "workspace:^",
    "jsdom": "^26.1.0",
    "@zaakiyjs/forms": "workspace:^",
    "@zaakiyjs/vite-plugin": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
