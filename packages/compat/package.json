{
  "name": "@zaakiyjs/compat",
  "version": "0.1.0-beta.0",
  "license": "MIT",
  "author": {
    "name": "Sanu Khan",
    "url": "https://sanukhan.dev"
  },
  "type": "module",
  "description": "Deterministic compiler-managed browser compatibility analysis, manifest planning and scoped AbortSignal helpers",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abort": {
      "types": "./dist/abort.d.ts",
      "import": "./dist/abort.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanukhandev/zaakiyjs.git",
    "directory": "packages/compat"
  },
  "homepage": "https://github.com/sanukhandev/zaakiyjs",
  "bugs": {
    "url": "https://github.com/sanukhandev/zaakiyjs/issues"
  }
}
