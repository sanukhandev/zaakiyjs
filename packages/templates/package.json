{
  "name": "@zaakiyjs/templates",
  "version": "0.0.0",
  "description": "Deterministic editable ZaakiyJS application template catalog and materializer",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run test",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@zaakiyjs/compiler": "workspace:^",
    "@zaakiyjs/core": "workspace:^",
    "@zaakiyjs/dom": "workspace:^",
    "@zaakiyjs/signals": "workspace:^",
    "@zaakiyjs/forms": "workspace:^",
    "@zaakiyjs/async": "workspace:^",
    "@zaakiyjs/styles": "workspace:^",
    "@zaakiyjs/vite-plugin": "workspace:^"
  }
}
